# Copy to .env.local for local dev. NEVER commit .env.local.
# Keys are used ONLY by node scripts/* (build-time). The Vite frontend
# must never read these — anything VITE_* ships to the browser.
CONGRESS_API_KEY=
# OpenAI-compatible endpoint for build-time simplification (scripts/simplify.mjs)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
